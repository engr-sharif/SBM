# build output — regenerate with: python tools/build_dist.py
dist/

# node / playwright (install with: cd test && npm install)
node_modules/
test/node_modules
package-lock.json

# python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# local scratch (never commit master rasters, LAS, DWG, or EA zips)
*.f32
*.f32.zst
*.las
*.laz
*.dwg
*.dxf
*.mms
*.zip
_staging/
_to_delete/

# the runner's per-step logs (test/run.mjs, v18 §1) — one log per step, a live
# PROGRESS file, summary.json and the browser lock. Regenerated by every run.
test/.logs
test/.logs/

# kernel-harness decoded-terrain cache (test/lib/terrain.mjs).
# BOTH forms, and the one without the slash is the one that matters: an agent
# worktree makes test/.cache a SYMLINK into the main checkout, `test/.cache/`
# matches a directory and not a symlink, and one got committed that way — an
# absolute path to one machine's disk, which broke the Pages build.
test/.cache
test/.cache/

# agent worktrees (Claude Code isolation)
.claude/worktrees/
