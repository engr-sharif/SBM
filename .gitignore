# build output — regenerate with: python tools/build_dist.py
dist/

# node / playwright (install with: cd test && npm install)
node_modules/
test/node_modules
package-lock.json

# python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# local scratch (never commit master rasters, LAS, DWG, or EA zips)
*.f32
*.f32.zst
*.las
*.laz
*.dwg
*.dxf
*.mms
*.zip
_staging/
_to_delete/

# kernel-harness decoded-terrain cache (test/lib/terrain.mjs)
test/.cache/
# ...and the path itself, because an agent worktree makes test/.cache a SYMLINK
# into the main checkout and a trailing-slash pattern does not match a symlink.
# One got committed that way (an absolute path to one machine's disk, useless
# anywhere else); this is what stops the next one.
test/.cache

# agent worktrees (Claude Code isolation)
.claude/worktrees/
